import { n as PLUGIN_NAME } from "./constants-DEnDBOsM.js";
import { n as unplugin } from "./src-X7BiPJ-v.js";

//#region src/astro.ts
/**
* Astro integration
*
* @example
* ```ts
* // astro.config.mjs
* import yaml from "unplugin-yaml/astro"
*
* export default defineConfig({
*   integrations: [yaml()],
* })
* ```
*/
function YamlIntegration(options) {
	return {
		name: PLUGIN_NAME,
		hooks: { "astro:config:setup": async (astro) => {
			astro.config.vite.plugins ||= [];
			astro.config.vite.plugins.push(unplugin.vite(options));
		} }
	};
}

//#endregion
export { YamlIntegration as default };
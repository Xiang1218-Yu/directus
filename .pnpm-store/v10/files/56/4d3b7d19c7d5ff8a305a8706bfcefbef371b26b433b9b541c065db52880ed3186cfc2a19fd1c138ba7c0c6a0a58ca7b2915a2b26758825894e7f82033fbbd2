{
  "name": "unplugin-yaml",
  "version": "3.0.7",
  "description": "Allow importing YAML files as JSON or Strings",
  "type": "module",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/unplugin-yaml.git"
  },
  "bugs": "https://github.com/luxass/unplugin-yaml/issues",
  "keywords": [
    "yaml",
    "unplugin",
    "vite",
    "webpack",
    "rollup",
    "esbuild",
    "nuxt",
    "astro"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/astro.d.ts",
        "default": "./dist/astro.js"
      },
      "require": {
        "types": "./dist/astro.d.cts",
        "default": "./dist/astro.cjs"
      }
    },
    "./farm": {
      "import": {
        "types": "./dist/farm.d.ts",
        "default": "./dist/farm.js"
      },
      "require": {
        "types": "./dist/farm.d.cts",
        "default": "./dist/farm.cjs"
      }
    },
    "./rspack": {
      "import": {
        "types": "./dist/rspack.d.ts",
        "default": "./dist/rspack.js"
      },
      "require": {
        "types": "./dist/rspack.d.cts",
        "default": "./dist/rspack.cjs"
      }
    },
    "./rolldown": {
      "import": {
        "types": "./dist/rolldown.d.ts",
        "default": "./dist/rolldown.js"
      },
      "require": {
        "types": "./dist/rolldown.d.cts",
        "default": "./dist/rolldown.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/esbuild.d.ts",
        "default": "./dist/esbuild.js"
      },
      "require": {
        "types": "./dist/esbuild.d.cts",
        "default": "./dist/esbuild.cjs"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt.d.ts",
        "default": "./dist/nuxt.js"
      },
      "require": {
        "types": "./dist/nuxt.d.cts",
        "default": "./dist/nuxt.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/rollup.d.ts",
        "default": "./dist/rollup.js"
      },
      "require": {
        "types": "./dist/rollup.d.cts",
        "default": "./dist/rollup.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/webpack.d.ts",
        "default": "./dist/webpack.js"
      },
      "require": {
        "types": "./dist/webpack.d.cts",
        "default": "./dist/webpack.cjs"
      }
    },
    "./types": {
      "types": "./yaml.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "yaml.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "playground/*"
  ],
  "peerDependencies": {
    "@nuxt/kit": ">=3",
    "@nuxt/schema": ">=3",
    "@rspack/core": "^1.0.13",
    "astro": ">=3",
    "esbuild": "*",
    "rolldown": ">=0.14.0",
    "rollup": ">=3",
    "vite": ">=3",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@nuxt/schema": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    }
  },
  "dependencies": {
    "@rollup/pluginutils": "5.3.0",
    "unplugin": "2.3.10",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@luxass/eslint-config": "6.0.1",
    "@luxass/utils": "2.7.2",
    "@nuxt/kit": "4.2.0",
    "@nuxt/schema": "4.2.0",
    "@rspack/core": "1.5.8",
    "@types/node": "22.18.1",
    "esbuild": "0.25.11",
    "eslint": "^9.38.0",
    "publint": "0.3.15",
    "rolldown": "1.0.0-beta.45",
    "rollup": "4.52.5",
    "tsdown": "0.15.10",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.4",
    "vitest-testdirs": "4.3.0",
    "webpack": "5.102.1"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "play:nuxt": "pnpm run --filter @unplugin-yaml/nuxt-example dev",
    "play:vite-vue": "pnpm run --filter @unplugin-yaml/vite-vue-example dev",
    "play:vite-react": "pnpm run --filter @unplugin-yaml/vite-react-example dev",
    "play:nextjs": "pnpm run --filter @unplugin-yaml/nextjs-example dev",
    "play:astro": "pnpm run --filter @unplugin-yaml/astro-example dev",
    "play:rspack": "pnpm run --filter @unplugin-yaml/rspack-example dev",
    "typecheck": "tsc --noEmit && pnpm -r typecheck"
  }
}